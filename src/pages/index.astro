---
import BaseHead from "../components/BaseHead.astro";
import HeroNotes from "../components/HeroNotes.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="pl">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Przejdź do treści
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Matpol, strona główna">
        <img src="/matpol-logo.jpg" alt="Matpol" />
      </a>
      <nav aria-label="Główna nawigacja">
        <a href="#oferta">Oferta</a>
        <a href="#o-nas">O nas</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            Korepetycje w Szczecinie <span aria-hidden="true">✳</span>
          </p>
          <h1 id="hero-title">
            Dwa przedmioty.
            <br />
            <em>Więcej pewności.</em>
          </h1>
          <p class="hero-lead">
            Wybierz korepetycje z języka polskiego lub matematyki. Każdy
            przedmiot to osobne zajęcia z nauczycielem, w tempie dopasowanym do
            Ciebie.
          </p>
          <a class="button" href="#kontakt">
            Porozmawiajmy <span aria-hidden="true">↗</span>
          </a>
        </div>
        <HeroNotes />
      </section>
      <section class="intro-band" aria-label="Najważniejsze informacje">
        <p>
          <strong>60 minut</strong> każda lekcja
        </p>
        <span aria-hidden="true">/</span>
        <p>
          <strong>2 przedmioty</strong> do wyboru
        </p>
        <span aria-hidden="true">/</span>
        <p>
          <strong>Szczecin</strong> UL. SMOLAŃSKA 4
        </p>
      </section>
      <section class="section offer" id="oferta" aria-labelledby="offer-title">
        <div class="section-heading">
          <p class="eyebrow">Co możemy zrobić</p>
          <h2 id="offer-title">
            Nauka, która
            <br />
            <em>ma sens.</em>
          </h2>
        </div>
        <div class="offer-grid">
          <article class="offer-card polish-card">
            <span class="subject-mark" aria-hidden="true">
              Aa
            </span>
            <h3>Język polski</h3>
            <p>
              Czytamy, rozumiemy i znajdujemy własne słowa. Porządkujemy myśli,
              żeby łatwiej było mówić i pisać.
            </p>
          </article>
          <article class="offer-card math-card">
            <span class="subject-mark" aria-hidden="true">
              ∑
            </span>
            <h3>Matematyka</h3>
            <p>
              Rozkładamy zadania na mniejsze kroki. Szukamy sposobu, który
              naprawdę jest zrozumiały.
            </p>
          </article>
        </div>
      </section>
      <section class="section about" id="o-nas" aria-labelledby="about-title">
        <div class="about-marker" aria-hidden="true">
          ✳
        </div>
        <div>
          <p class="eyebrow">Dwie perspektywy</p>
          <h2 id="about-title">
            Ucz się
            <br />
            <em>po swojemu.</em>
          </h2>
        </div>
        <div class="about-text">
          <p>
            Matpol tworzy dwoje nauczycieli — jedna osoba prowadzi język
            polski, druga matematykę. Zajęcia z obu przedmiotów odbywają się
            niezależnie.
          </p>
          <p class="muted">
            Każde spotkanie to czas na pytania, próby i własne tempo.
          </p>
        </div>
      </section>
      <section class="contact" id="kontakt" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow light">Kontakt</p>
          <h2 id="contact-title">
            Masz pytanie?
            <br />
            <em>Zacznijmy od rozmowy.</em>
          </h2>
        </div>
        <div class="contact-details">
          <div class="location-block">
            <div class="location-copy">
              <p>
                Spotykamy się w Szczecinie
                <br />
                <strong>UL. SMOLAŃSKA 4</strong>
              </p>
              <a
                class="contact-link"
                href="https://maps.google.com/?q=UL.+SMOLA%C5%83SKA+4,+Szczecin"
                target="_blank"
                rel="noreferrer"
              >
                Zobacz adres na mapie ↗
              </a>
            </div>
            <div class="map-frame">
              <iframe
                src="https://www.google.com/maps/embed?origin=mfe&pb=!1m2!2m1!1sUL.+SMOLA%C5%83SKA+4,+Szczecin"
                title="Mapa dojazdu do UL. SMOLAŃSKA 4 w Szczecinie"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
          <div class="preferred-contact">
            <span>Preferowany kontakt</span>
            <a href="mailto:matpolkorepetycje@gmail.com">
              matpolkorepetycje@gmail.com
            </a>
          </div>
          <div class="phones">
            <p>
              <span>Język polski · numer do uzupełnienia</span>
              <strong>+48 XXX XXX XXX</strong>
            </p>
            <p>
              <span>Matematyka · numer do uzupełnienia</span>
              <strong>+48 XXX XXX XXX</strong>
            </p>
          </div>
          <div class="social-links" aria-label="Media społecznościowe">
            <a
              href="https://www.instagram.com/matpol.korepetycje/"
              target="_blank"
              rel="noreferrer"
            >
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.087 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.269.087 3.85.048 4.703.01 5.556 0 5.829 0 8s.01 2.444.048 3.297c.039.853.174 1.435.372 1.944.205.526.478.972.923 1.417.445.445.891.718 1.417.923.509.198 1.09.333 1.944.372C5.556 15.99 5.829 16 8 16s2.444-.01 3.297-.048c.853-.039 1.435-.174 1.944-.372a3.9 3.9 0 0 0 1.417-.923c.445-.445.718-.891.923-1.417.198-.509.333-1.09.372-1.944C15.99 10.444 16 10.171 16 8s-.01-2.444-.048-3.297c-.039-.853-.174-1.435-.372-1.944a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.509-.198-1.09-.333-1.944-.372C10.444.01 10.171 0 8 0m0 1.44c2.41 0 2.69.009 3.637.052.877.04 1.354.187 1.67.31.42.163.72.358 1.036.673.315.315.51.616.673 1.036.123.316.27.793.31 1.67.043.947.052 1.227.052 3.637s-.009 2.69-.052 3.637c-.04.877-.187 1.354-.31 1.67-.163.42-.358.72-.673 1.036a2.47 2.47 0 0 1-1.036.673c-.316.123-.793.27-1.67.31-.947.043-1.227.052-3.637.052s-2.69-.009-3.637-.052c-.877-.04-1.354-.187-1.67-.31a2.47 2.47 0 0 1-1.036-.673 2.47 2.47 0 0 1-.673-1.036c-.123-.316-.27-.793-.31-1.67C1.449 10.69 1.44 10.41 1.44 8s.009-2.69.052-3.637c.04-.877.187-1.354.31-1.67.163-.42.358-.72.673-1.036.315-.315.616-.51 1.036-.673.316-.123.793-.27 1.67-.31C5.31 1.449 5.59 1.44 8 1.44m0 2.348a4.212 4.212 0 1 0 0 8.424 4.212 4.212 0 0 0 0-8.424m0 6.945a2.733 2.733 0 1 1 0-5.466 2.733 2.733 0 0 1 0 5.466m5.338-6.987a.984.984 0 1 0 0 1.968.984.984 0 0 0 0-1.968" />
              </svg>
              Instagram ↗
            </a>
            <a
              href="https://www.facebook.com/profile.php?id=61587964407762"
              target="_blank"
              rel="noreferrer"
            >
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M16 8.049C16 3.604 12.418 0 8 0S0 3.604 0 8.049c0 4.017 2.925 7.347 6.75 7.951v-5.625H4.72V8.05h2.03V6.276c0-2.02 1.194-3.136 3.022-3.136.876 0 1.791.157 1.791.157v1.98h-1.009c-.994 0-1.304.621-1.304 1.258V8.05h2.218l-.355 2.326H9.25V16c3.825-.604 6.75-3.934 6.75-7.951" />
              </svg>
              Facebook ↗
            </a>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Matpol</span>
      <span>Korepetycje w Szczecinie</span>
      <a href="#main">Na górę ↑</a>
    </footer>
  </body>
</html>
