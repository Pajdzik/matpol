---
import BaseHead from "../components/BaseHead.astro";
import HeroNotes from "../components/HeroNotes.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="pl">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Przejdź do treści
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Matpol, strona główna">
        <img src="/matpol-logo.jpg" alt="Matpol" />
      </a>
      <nav aria-label="Główna nawigacja">
        <a href="#oferta">Oferta</a>
        <a href="#o-nas">O nas</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            Korepetycje w Szczecinie <span aria-hidden="true">✳</span>
          </p>
          <h1 id="hero-title">
            Dwa przedmioty.
            <br />
            <em>Więcej pewności.</em>
          </h1>
          <p class="hero-lead">
            Wybierz korepetycje z języka polskiego lub matematyki. Każdy
            przedmiot to osobne zajęcia z nauczycielem, w tempie dopasowanym do
            Ciebie.
          </p>
          <a class="button" href="#kontakt">
            Porozmawiajmy <span aria-hidden="true">↗</span>
          </a>
        </div>
        <HeroNotes />
      </section>
      <section class="intro-band" aria-label="Najważniejsze informacje">
        <p>
          <strong>60 minut</strong> każda lekcja
        </p>
        <span aria-hidden="true">/</span>
        <p>
          <strong>2 przedmioty</strong> do wyboru
        </p>
        <span aria-hidden="true">/</span>
        <p>
          <strong>Szczecin</strong> ul. Korepetycyjna 5
        </p>
      </section>
      <section class="section offer" id="oferta" aria-labelledby="offer-title">
        <div class="section-heading">
          <p class="eyebrow">Co możemy zrobić</p>
          <h2 id="offer-title">
            Nauka, która
            <br />
            <em>ma sens.</em>
          </h2>
        </div>
        <div class="offer-grid">
          <article class="offer-card polish-card">
            <span class="subject-mark" aria-hidden="true">
              Aa
            </span>
            <h3>Język polski</h3>
            <p>
              Czytamy, rozumiemy i znajdujemy własne słowa. Porządkujemy myśli,
              żeby łatwiej było mówić i pisać.
            </p>
          </article>
          <article class="offer-card math-card">
            <span class="subject-mark" aria-hidden="true">
              ∑
            </span>
            <h3>Matematyka</h3>
            <p>
              Rozkładamy zadania na mniejsze kroki. Szukamy sposobu, który
              naprawdę jest zrozumiały.
            </p>
          </article>
        </div>
      </section>
      <section class="section about" id="o-nas" aria-labelledby="about-title">
        <div class="about-marker" aria-hidden="true">
          ✳
        </div>
        <div>
          <p class="eyebrow">Dwie perspektywy</p>
          <h2 id="about-title">
            Ucz się
            <br />
            <em>po swojemu.</em>
          </h2>
        </div>
        <div class="about-text">
          <p>
            Matpol tworzy dwoje nauczycieli — jedna osoba prowadzi język
            polski, druga matematykę. Zajęcia z obu przedmiotów odbywają się
            niezależnie.
          </p>
          <p class="muted">
            Każde spotkanie to czas na pytania, próby i własne tempo.
          </p>
        </div>
      </section>
      <section class="contact" id="kontakt" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow light">Kontakt</p>
          <h2 id="contact-title">
            Masz pytanie?
            <br />
            <em>Zacznijmy od rozmowy.</em>
          </h2>
        </div>
        <div class="contact-details">
          <p>
            Spotykamy się w Szczecinie
            <br />
            przy ul. Korepetycyjnej 5.
          </p>
          <div class="phones">
            <p>
              <span>Język polski · numer do uzupełnienia</span>
              <strong>+48 XXX XXX XXX</strong>
            </p>
            <p>
              <span>Matematyka · numer do uzupełnienia</span>
              <strong>+48 XXX XXX XXX</strong>
            </p>
          </div>
          <a
            class="contact-link"
            href="https://maps.google.com/?q=ul.+Korepetycyjna+5,+Szczecin"
            target="_blank"
            rel="noreferrer"
          >
            Zobacz adres na mapie ↗
          </a>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Matpol</span>
      <span>Korepetycje w Szczecinie</span>
      <a href="#main">Na górę ↑</a>
    </footer>
  </body>
</html>
